{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.6",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "spatie/laravel-permission": "^7.3",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Ticket\\Payments\\": "packages/payments/src/",
            "Ticket\\Tenancy\\": "packages/tenancy/src/",
            "Ticket\\Ticketing\\": "packages/ticketing/src/",
            "Ticket\\PublicCatalog\\": "packages/public-catalog/src/",
            "Ticket\\Notifications\\": "packages/notifications/src/",
            "Ticket\\IdentityAccess\\": "packages/identity-access/src/",
            "Ticket\\ReferenceData\\": "packages/reference-data/src/",
            "Ticket\\MediaDocuments\\": "packages/media-documents/src/",
            "Ticket\\Cms\\": "packages/cms/src/",
            "Ticket\\Seo\\": "packages/seo/src/",
            "Ticket\\Localization\\": "packages/localization/src/",
            "Ticket\\Engagement\\": "packages/engagement/src/",
            "Ticket\\AccessControl\\": "packages/access-control/src/",
            "Ticket\\FinanceAccounting\\": "packages/finance-accounting/src/",
            "Ticket\\SupportObservability\\": "packages/support-observability/src/",
            "Ticket\\FormBuilder\\": "packages/form-builder/src/",
            "Ticket\\ContentEvents\\": "packages/content-events/src/",
            "Ticket\\ContentTraining\\": "packages/content-training/src/",
            "Ticket\\ContentStands\\": "packages/content-stands/src/",
            "Ticket\\ContentCallsForProjects\\": "packages/content-calls-for-projects/src/",
            "Ticket\\ContentCrowdfunding\\": "packages/content-crowdfunding/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "serve:local:windows": [
            "powershell -ExecutionPolicy Bypass -File scripts/serve_local_backend.ps1"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
