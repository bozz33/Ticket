NODE_ENV=development
PORT=4010

OUTBOX_POLL_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAY_SECONDS=60
OUTBOX_PROCESSING_TIMEOUT_SECONDS=300

OUTBOX_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ticket_central
NOTIFICATIONS_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ticket_notifications

EMAIL_PROVIDER=log
SMS_PROVIDER=log
IN_APP_PROVIDER=log
